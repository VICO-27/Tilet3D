# ==========================================================
# TILET3D BACKEND CONFIGURATION
# ==========================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.development  # Use config.settings.production in production

# Cross-Origin (CORS) & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Database (PostgreSQL)
# Either provide individual fields or DATABASE_URL:
DB_NAME=tilet3d
DB_USER=tilet3d_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Google OAuth2 (Google Identity Services)
# Client ID should match VITE_GOOGLE_CLIENT_ID on frontend
GOOGLE_CLIENT_ID=20804747116-j3hej0jvqmiftqasji18hll1p2hs6a5f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_optional_for_gis

# Email / OTP Delivery (Brevo, SendGrid, Gmail SMTP, etc.)
# In development, leave blank to print OTP codes directly to terminal
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@tilet3d.com
OTP_EXPIRY_MINUTES=10

# Media & Storage (Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Chapa)
CHAPA_SECRET_KEY=
CHAPA_CALLBACK_URL=http://localhost:8000/api/payments/webhook/
CHAPA_RETURN_URL=http://localhost:5173/checkout/success

# AI / Gemini (Primary)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# AI / Groq (Secondary Fallback)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=15

# Celery & Redis (Optional / Background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0